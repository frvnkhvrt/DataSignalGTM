# Supabase — canonical project: ilpgtiyezafzmekenktn
NEXT_PUBLIC_SUPABASE_URL=https://ilpgtiyezafzmekenktn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini (optional — playbook generation degrades gracefully without this)
GEMINI_API_KEY=your-gemini-api-key-here

# Inngest (optional locally with the dev server; required for hosted jobs)
INNGEST_EVENT_KEY=your-inngest-event-key-here
INNGEST_SIGNING_KEY=your-inngest-signing-key-here

# Demo reset (optional — enables the admin demo-reset endpoint)
DEMO_RESET_KEY=your-demo-reset-key-here

# ── Phase 3: Observability ─────────────────────────────────────────────────────

# Sentry (optional — omit to disable error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
# SENTRY_AUTH_TOKEN is only needed in CI/CD to upload source maps
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# PostHog (optional — omit to disable product analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature flags (optional — all enabled by default)
# FEATURE_FLAGS={"enable_rules_engine":true,"enable_advanced_charts":true,"enable_bulk_actions":true}
# Individual overrides (higher priority than FEATURE_FLAGS JSON):
# FEATURE_ENABLE_RULES_ENGINE=true
# FEATURE_ENABLE_ADVANCED_CHARTS=true
# FEATURE_ENABLE_BULK_ACTIONS=true
# FEATURE_ENABLE_AI_USAGE_PAGE=true
# FEATURE_ENABLE_COMMAND_PALETTE=true

# ── Phase 4: Billing & Monetization ──────────────────────────────────────────

# Stripe (required for billing features)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# External signal webhook secret
SIGNAL_WEBHOOK_SECRET=your-webhook-secret-here
